# Paperless-ngx. Copy to .env (gitignored) and fill in.
# Generate secrets with:  openssl rand -hex 32

# --- Required ---------------------------------------------------------------
PAPERLESS_SECRET_KEY=replace-with-a-random-hex-secret
PAPERLESS_DBPASS=replace-with-a-strong-hex-password
# First-run superuser. Created once; changing these later does nothing.
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=replace-with-a-strong-password

# --- Where you open it -------------------------------------------------------
# Exactly as typed in the browser (scheme + host + port). A mismatch gives
# "CSRF verification failed" on login.
PAPERLESS_URL=http://localhost:8200
# 127.0.0.1 = this machine only (use a reverse proxy / tunnel for outside
# access). 0.0.0.0 = also reachable from your LAN, e.g. for phone uploads.
PAPERLESS_BIND=127.0.0.1
PAPERLESS_PORT=8200

# --- Locale ------------------------------------------------------------------
TZ=America/Chicago
# Tesseract language codes, e.g. eng, deu, eng+spa
PAPERLESS_OCR_LANGUAGE=eng

# --- Host user ---------------------------------------------------------------
# Owner of ./data, ./consume and ./export on the host (run `id` to check).
PUID=1000
PGID=1000

# --- Shared Docker network (must match the other stacks) ---------------------
DOCKER_NETWORK=ourhome_net
