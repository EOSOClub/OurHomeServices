# MongoDB for OurHomeWeb. Copy to .env (gitignored) and fill in.
# Generate passwords as hex so they never need URL-encoding in a connection string:
#   openssl rand -hex 32

# Admin account. Only for maintenance (Compass, backups), never for the app.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=replace-with-a-strong-hex-password

# The account OurHomeWeb connects as. Must match DATABASE_URL in
# OurHomeWeb's .env:
#   mongodb://household:<MONGO_APP_PASSWORD>@mongo:27017/household?replicaSet=rs0&authSource=admin
MONGO_APP_USERNAME=household
MONGO_APP_PASSWORD=replace-with-a-strong-hex-password

# Host access (Compass / mongosh). 127.0.0.1 = this machine only.
MONGO_BIND=127.0.0.1
MONGO_HOST_PORT=27018

# The shared Docker network (must match OurHomeWeb's DOCKER_NETWORK).
DOCKER_NETWORK=ourhome_net
